#!/usr/bin/env python3
"""Runs an iOS project's tests the same way in every project, and checks the result.

    ios-test quick                 one iPhone: the UI tests, or the unit tests if there are none
    ios-test close                 one iPhone and one iPad: all tests
    ios-test release               the same, and every simulator in RELEASE_SIMULATORS
    ios-test quick --simulator ID  that simulator
    ios-test quick --only Target/Class/test
    ios-test quick --only Target/Class/test --iterations 3

Settings come from .ios-test in the current folder (or --config), as KEY=value lines:

    PROJECT=App.xcodeproj           leave out for a Swift package
    SCHEME=App
    UI_TESTS=AppUITests
    UNIT_TESTS=AppTests
    TEST_ARGS=-testLanguage en -testRegion US
    DEVICES=iphone                  for an iPhone-only app: close runs no iPad
    RELEASE_SIMULATORS=iPhone 16@18.5, iPad mini (A17 Pro)@26.2

A run fails if xcodebuild fails, and also in two cases xcodebuild reports as success: the test
runner restarted, or no test ran. A run also fails if the log shows cloned simulators. Full logs
and result bundles stay in test-logs/. At most two simulators run at a time.

Every run lists the compiler's warnings in the project's own files, those inside macros such as
#expect included; a package built from outside the project is left out. close and release build
from clean and fail on any warning. quick does not fail on them, and builds only what changed, so
it lists the warnings of the files it compiled.

Simulators run in pairs. Before a pair's tests, each simulator boots if it is down and settles, one
at a time, and its text size, appearance, and contrast go back to the system's defaults. A pair this
run booted shuts down before the next pair starts.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

LOGS = Path("test-logs")
MAX_SIMULATORS = 2

# A simulator keeps these after a person or another project changes them, and they move the layout:
# at a larger text size, a list row that fits at the default can end up below the fold, and a row
# off screen is not in the accessibility tree.
DISPLAY_DEFAULTS = {"content_size": "large", "appearance": "light", "increase_contrast": "disabled"}

# A simulator goes on working long after it says it has booted. An iOS 27 simulator held the load
# average of a 16 GB Mac above 100 for four minutes and took ten to settle, and tests in that time
# run slowly and can time out.
SETTLE_MINUTES = 12

# "/path/File.swift:12:98: warning: …", or, for a file the compiler reads as a whole,
# "/path/Assets.xcassets: warning: …". xcodebuild prints each one more than once.
WARNING = re.compile(r"^(/[^:\n]+?)(:\d+(?::\d+)?)?: warning: (.+)$", re.MULTILINE)

# A warning inside a macro such as #expect names the macro, and its next line the file and line.
MACRO_WARNING = re.compile(
    r"^macro expansion [^:\n]+:\d+:\d+: warning: (.+)\n"
    r"`- (/[^:\n]+?)(:\d+:\d+): note: expanded code originates here$",
    re.MULTILINE,
)


@dataclass(frozen=True)
class Simulator:
    udid: str
    name: str
    version: tuple[int, int]
    booted: bool = False

    @property
    def label(self) -> str:
        return f"{self.name} (iOS {self.version[0]}.{self.version[1]})"


@dataclass
class Result:
    suite: str
    simulator: Simulator
    passed: int
    failed: int
    skipped: int
    restarts: int
    problem: str | None
    failures: list[str]
    log: Path


def fail(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(2)


def read_config(path: Path) -> dict[str, str]:
    if not path.exists():
        fail(f"no {path} here; see ios-test --help")
    config = {}
    for number, line in enumerate(path.read_text().splitlines(), start=1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator:
            fail(f"{path}:{number}: expected KEY=value")
        config[key.strip()] = value.strip()
    if "SCHEME" not in config:
        fail(f"{path} has no SCHEME")
    if "UI_TESTS" not in config and "UNIT_TESTS" not in config:
        fail(f"{path} has neither UI_TESTS nor UNIT_TESTS")
    return config


def available_simulators() -> list[Simulator]:
    output = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "available", "-j"],
        check=True, capture_output=True, text=True,
    ).stdout
    simulators = []
    for runtime, devices in json.loads(output)["devices"].items():
        match = re.search(r"iOS-(\d+)-(\d+)", runtime)
        if match:
            version = (int(match[1]), int(match[2]))
            simulators += [
                Simulator(d["udid"], d["name"], version, d["state"] == "Booted") for d in devices
            ]
    return simulators


def plain_iphones(simulators: list[Simulator]) -> list[Simulator]:
    return [s for s in simulators if re.fullmatch(r"iPhone \d+.*", s.name)]


def ipads(simulators: list[Simulator]) -> list[Simulator]:
    return [s for s in simulators if s.name.startswith("iPad")]


def preferred(simulators: list[Simulator]) -> Simulator:
    """The plainest model of these: an iPad mini, or the shortest name."""
    return min(simulators, key=lambda s: ("mini" not in s.name, len(s.name), s.name))


def newest_iphone(simulators: list[Simulator]) -> Simulator:
    phones = plain_iphones(simulators)
    if not phones:
        fail("no iPhone simulator is available")
    newest = max(s.version for s in phones)
    return preferred([s for s in phones if s.version == newest])


def newest_pair(simulators: list[Simulator]) -> list[Simulator]:
    """An iPhone and an iPad on the newest iOS that has both."""
    phones, tablets = plain_iphones(simulators), ipads(simulators)
    shared = {s.version for s in phones} & {s.version for s in tablets}
    if not shared:
        fail("no iOS version has both an iPhone and an iPad simulator")
    newest = max(shared)
    return [
        preferred([s for s in phones if s.version == newest]),
        preferred([s for s in tablets if s.version == newest]),
    ]


def named_simulators(names: str, simulators: list[Simulator]) -> list[Simulator]:
    """Finds each 'Name@18.5' of a comma-separated list."""
    found = []
    for entry in filter(None, (part.strip() for part in names.split(","))):
        name, _, version = entry.partition("@")
        matches = [
            s for s in simulators
            if s.name == name.strip() and f"{s.version[0]}.{s.version[1]}".startswith(version.strip())
        ]
        if not matches:
            fail(f"no simulator matches '{entry}' in RELEASE_SIMULATORS")
        found.append(max(matches, key=lambda s: s.version))
    return found


def choose_simulators(stage: str, wanted: str | None, config: dict[str, str]) -> list[Simulator]:
    simulators = available_simulators()
    if wanted:
        matches = [s for s in simulators if s.udid == wanted]
        return matches or [Simulator(wanted, wanted, (0, 0))]
    if stage == "quick":
        return [newest_iphone(simulators)]
    chosen = [newest_iphone(simulators)] if config.get("DEVICES") == "iphone" else newest_pair(simulators)
    if stage == "release":
        extra = named_simulators(config.get("RELEASE_SIMULATORS", ""), simulators)
        chosen += [s for s in extra if s not in chosen]
    return chosen


def base_command(config: dict[str, str]) -> list[str]:
    command = ["xcodebuild"]
    if "PROJECT" in config:
        command += ["-project", config["PROJECT"]]
    return command + ["-scheme", config["SCHEME"]]


def build(config: dict[str, str], simulator: Simulator, clean: bool) -> list[str]:
    """Builds the tests, from clean if asked, and returns the warnings in the project's own files."""
    log = LOGS / f"build-{config['SCHEME']}.log"
    print("Building for testing from clean…" if clean else "Building for testing…", flush=True)
    # An incremental build compiles only what changed, and so prints only the warnings of those files.
    actions = ["clean", "build-for-testing"] if clean else ["build-for-testing"]
    with log.open("w") as output:
        status = subprocess.run(
            base_command(config) + actions + ["-destination", f"id={simulator.udid}"],
            stdout=output, stderr=subprocess.STDOUT,
        ).returncode
    text = log.read_text(errors="replace")
    if status != 0:
        for line in text.splitlines():
            if "error:" in line:
                print(line[:200], file=sys.stderr)
        fail(f"the build failed; see {log}")
    warnings = read_warnings(text, Path.cwd())
    if warnings:
        print(f"{plural(len(warnings), 'warning')} in the build:")
        for warning in warnings[:20]:
            print(f"  {warning[:200]}")
        if len(warnings) > 20:
            print(f"  and {len(warnings) - 20} more in {log}")
    return warnings


def read_warnings(log: str, root: Path) -> list[str]:
    """The warnings in files under root, each once, as 'path:line:column: message'."""
    found = [(m[1], m[2] or "", m[3]) for m in WARNING.finditer(log)]
    found += [(m[2], m[3], m[1]) for m in MACRO_WARNING.finditer(log)]
    prefix = f"{root}/"
    # A package the project depends on builds from a checkout outside it, and is not the project's to fix.
    return sorted({
        f"{path.removeprefix(prefix)}{place}: {message}"
        for path, place, message in found if path.startswith(prefix)
    })


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def wait_until_settled(simulator: Simulator) -> None:
    """Waits until the Mac is no busier than it has cores, or for SETTLE_MINUTES."""
    print(f"Letting {simulator.label} settle after booting…", flush=True)
    time.sleep(60)  # The load average looks back a minute.
    deadline = time.monotonic() + SETTLE_MINUTES * 60
    while os.getloadavg()[0] > (os.cpu_count() or 1):
        if time.monotonic() > deadline:
            print(f"{simulator.label}: still busy after {SETTLE_MINUTES} minutes, going on", flush=True)
            return
        time.sleep(5)


def prepare(simulator: Simulator) -> None:
    """Boots the simulator if it is down, lets it settle, and resets its display settings."""
    booted = subprocess.run(
        ["xcrun", "simctl", "bootstatus", simulator.udid, "-b"], capture_output=True, text=True,
    )
    if booted.returncode != 0:
        fail(f"could not boot {simulator.label}: {booted.stderr.strip()}")
    # A CI machine has nothing else to do, and a time limit.
    if not simulator.booted and "CI" not in os.environ:
        wait_until_settled(simulator)
    for setting, default in DISPLAY_DEFAULTS.items():
        command = ["xcrun", "simctl", "ui", simulator.udid, setting]
        current = subprocess.run(command, capture_output=True, text=True).stdout.strip()
        if current not in (default, "unsupported"):
            print(f"{simulator.label}: {setting} was {current}, now {default}", flush=True)
            subprocess.run(command + [default], check=True, capture_output=True)


def read_summary(bundle: Path) -> dict:
    """The counts and failures in a result bundle, or nothing if the run left none to read."""
    output = subprocess.run(
        ["xcrun", "xcresulttool", "get", "test-results", "summary", "--path", str(bundle)],
        capture_output=True, text=True,
    )
    return json.loads(output.stdout) if output.returncode == 0 else {}


def read_result(suite: str, simulator: Simulator, status: int, log: Path, bundle: Path) -> Result:
    text = log.read_text(errors="replace")
    # The log prints a parameterized test once per argument, and can leave a line out.
    summary = read_summary(bundle)
    passed = summary.get("passedTests", 0) + summary.get("expectedFailures", 0)
    failed = summary.get("failedTests", 0)
    skipped = summary.get("skippedTests", 0)
    restarts = text.count("Restarting after unexpected exit")
    problem = None
    if status != 0 and not failed:
        problem = "xcodebuild failed"
    elif restarts:
        problem = "the test runner restarted"
    elif passed + failed + skipped == 0:
        problem = "no test ran"
    elif re.search(r"Clone \d+ of ", text):
        problem = "tests ran on cloned simulators"
    failures = sorted({
        f"{failure.get('testIdentifierString', failure['testName'])}: "
        f"{' '.join(failure['failureText'].split())[:100]}"
        for failure in summary.get("testFailures", [])
    })
    return Result(suite, simulator, passed, failed, skipped, restarts, problem, failures, log)


def run_tests(
    config: dict[str, str], suite: str, targets: list[str], simulator: Simulator, iterations: int
) -> Result:
    name = re.sub(r"[^A-Za-z0-9.]+", "-", f"{suite}-{simulator.name}-{simulator.version[0]}.{simulator.version[1]}")
    log = LOGS / f"{name}.log"
    # Without a path of its own, two runs that start in the same second share one result bundle.
    results = LOGS / f"{name}.xcresult"
    shutil.rmtree(results, ignore_errors=True)
    # Parallel testing clones the simulator, and clones booting together stall a small Mac.
    command = base_command(config) + [
        "test-without-building", "-destination", f"id={simulator.udid}",
        "-resultBundlePath", str(results), "-parallel-testing-enabled", "NO",
    ]
    command += [f"-only-testing:{target}" for target in targets]
    if iterations > 1:
        command += ["-test-iterations", str(iterations)]
    command += shlex.split(config.get("TEST_ARGS", ""))
    print(f"Running {suite} on {simulator.label}…", flush=True)
    with log.open("w") as output:
        status = subprocess.run(command, stdout=output, stderr=subprocess.STDOUT).returncode
    return read_result(suite, simulator, status, log, results)


def report(results: list[Result]) -> bool:
    print()
    print(f"{'Suite':<7}{'Simulator':<36}{'Passed':>7}{'Failed':>7}{'Skipped':>8}  Result")
    for result in results:
        outcome = result.problem or ("FAILED" if result.failed else "ok")
        print(
            f"{result.suite:<7}{result.simulator.label:<36}{result.passed:>7}"
            f"{result.failed:>7}{result.skipped:>8}  {outcome}"
        )
    good = True
    for result in results:
        if result.failures:
            print(f"\n{result.suite} on {result.simulator.label}:")
            for failure in result.failures[:20]:
                print(f"  {failure}")
        if result.problem or result.failed:
            print(f"  full log: {result.log}")
            good = False
    return good


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("stage", choices=["quick", "close", "release"])
    parser.add_argument("--simulator", help="a simulator's id, instead of choosing one")
    parser.add_argument(
        "--only", action="append", help="Target/Class/test, instead of the whole suite; can repeat"
    )
    parser.add_argument(
        "--iterations", type=int, default=1,
        help="how many times to run each test; one failure among them fails the test",
    )
    parser.add_argument("--config", default=".ios-test", type=Path)
    args = parser.parse_args()
    config = read_config(args.config)
    LOGS.mkdir(exist_ok=True)
    (LOGS / ".gitignore").write_text("*\n")

    simulators = choose_simulators(args.stage, args.simulator, config)
    strict = args.stage != "quick"
    warnings = build(config, simulators[0], clean=strict)

    ui, unit = config.get("UI_TESTS"), config.get("UNIT_TESTS")
    if args.only:
        ui_tests = [test for test in args.only if ui is not None and test.startswith(ui)]
        unit_tests = [test for test in args.only if test not in ui_tests]
        suites = [("ui", ui_tests), ("unit", unit_tests)]
    elif args.stage == "quick":
        suites = [("ui", [ui])] if ui else [("unit", [unit])]
    else:
        suites = [("ui", [ui] if ui else []), ("unit", [unit] if unit else [])]

    results: list[Result] = []
    pairs = [simulators[i:i + MAX_SIMULATORS] for i in range(0, len(simulators), MAX_SIMULATORS)]
    for pair in pairs:
        for simulator in pair:
            prepare(simulator)
        with concurrent.futures.ThreadPoolExecutor(MAX_SIMULATORS) as pool:
            for suite, targets in suites:
                if targets:
                    results += pool.map(
                        lambda s: run_tests(config, suite, targets, s, args.iterations), pair
                    )
        if pair is not pairs[-1]:
            for simulator in pair:
                if not simulator.booted:
                    subprocess.run(["xcrun", "simctl", "shutdown", simulator.udid], capture_output=True)

    good = report(results)
    if strict and warnings:
        print(f"\nThe build has {plural(len(warnings), 'warning')}, and {args.stage} allows none.")
        good = False
    return 0 if good else 1


if __name__ == "__main__":
    sys.exit(main())
